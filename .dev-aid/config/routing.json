{
  "default_mode": "solo",
  "modes": {
    "solo": {
      "description": "Single model handles everything",
      "primary_model": "sonnet-4.6"
    },
    "challenger": {
      "description": "Primary generates, challenger reviews",
      "enabled": true,
      "primary_model": "sonnet-4.6",
      "challenger_model": "opus-4.6",
      "auto_refine_on": ["HIGH", "CRITICAL"],
      "review_triggers": [
        "auth",
        "authentication",
        "password",
        "crypto",
        "encryption",
        "token",
        "session",
        "oauth",
        "jwt",
        "security",
        "credential",
        "api_key"
      ]
    },
    "ensemble": {
      "description": "Route by task type",
      "enabled": true,
      "routing_strategy": "semantic",
      "task_routes": {
        "massive_context": "flash-2.5",
        "code_generation": "sonnet-4.6",
        "security_audit": "opus-4.6",
        "documentation": "gpt-4o",
        "debugging": "sonnet-4.6",
        "complex_reasoning": "opus-4.6"
      }
    }
  },
  "fallback_chain": [
    "sonnet-4.6",
    "gpt-4o",
    "flash-2.5"
  ],
  "cost_limit_per_day": 100.0,
  "logging": {
    "enabled": true,
    "log_file": ".dev-aid/logs/routing.log",
    "log_level": "info"
  }
}

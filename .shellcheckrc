# Shellcheck configuration for Dev-AID

# Disable SC2155 (declare and assign separately) for library files.
# This is a common pattern in our codebase; where the masked exit status
# actually matters, prefer an inline `# shellcheck disable=SC2155` with a
# per-site reason rather than relying on this global exemption.
#
# NOTE: SC2034 (unused variables) is intentionally NOT globally disabled
# (audit): it flags real dead code / typos. Silence genuine
# reserved-for-future-use cases with a scoped inline disable instead.
disable=SC2155

# Keep important checks enabled
# SC2086: Double quote to prevent globbing and word splitting
# SC2046: Quote this to prevent word splitting
# SC2001: See if you can use ${variable//search/replace} instead
